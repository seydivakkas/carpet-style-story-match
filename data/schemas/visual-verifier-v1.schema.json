{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VisualVerificationResult",
  "description": "Schema for deterministic small-VLM visual proposal verifier output in V2-09C",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "decision",
    "proposed_visual_candidate_key",
    "verified_visual_candidate_key",
    "visual_evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "visual-verifier-v1.0.0"
    },
    "proposal_id": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": ["ACCEPT", "REJECT", "ABSTAIN"]
    },
    "proposed_visual_candidate_key": {
      "type": "string",
      "enum": [
        "medallion_like",
        "niche_like",
        "star_like",
        "rosette_like",
        "palmette_like",
        "lotus_like",
        "vine_scroll_like",
        "cloud_band_like",
        "tree_like",
        "horn_like",
        "human_figure_like_geometric",
        "comb_like",
        "hook_like",
        "lattice_like",
        "lozenge_like",
        "octagonal_form",
        "unmapped_visual_motif"
      ]
    },
    "verified_visual_candidate_key": {
      "type": ["string", "null"],
      "enum": [
        "medallion_like",
        "niche_like",
        "star_like",
        "rosette_like",
        "palmette_like",
        "lotus_like",
        "vine_scroll_like",
        "cloud_band_like",
        "tree_like",
        "horn_like",
        "human_figure_like_geometric",
        "comb_like",
        "hook_like",
        "lattice_like",
        "lozenge_like",
        "octagonal_form",
        "unmapped_visual_motif",
        null
      ]
    },
    "visual_evidence": {
      "type": "string",
      "maxLength": 200,
      "description": "Short bounded visual-only description of observed geometry and feature points"
    },
    "abstention_reason": {
      "type": ["string", "null"],
      "description": "Reason for abstention if decision is ABSTAIN"
    },
    "model_provenance": {
      "type": ["string", "null"],
      "description": "Model ID or candidate ID generating the verification decision"
    }
  }
}
