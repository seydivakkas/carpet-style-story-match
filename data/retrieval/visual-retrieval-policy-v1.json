{
  "policy_version": "visual-retrieval-policy-v1.0.0",
  "algorithm_version": "style-dna-v1.0.0",
  "retrieval_version": "visual-retrieval-v1.0.0",
  "dimensions": [
    "D1 color_energy",
    "D2 color_diversity",
    "D3 contrast",
    "D4 warmth",
    "D5 visual_complexity",
    "D6 structural_order",
    "D7 rhythm_repetition",
    "D8 focal_strength",
    "D9 form_language"
  ],
  "dimension_numeric_range": [0.0, 1.0],
  "distance_method": "normalized_weighted_euclidean",
  "distance_equation": "d_norm = sqrt( sum(w_i * (q_i - c_i)^2) / sum(w_i) )",
  "distance_range": [0.0, 1.0],
  "equal_weight_policy": "FROZEN_UNIFORM_WEIGHTS_1.0_NO_USER_PREFERENCE_WEIGHTING",
  "weights": {
    "color_energy": 1.0,
    "color_diversity": 1.0,
    "contrast": 1.0,
    "warmth": 1.0,
    "visual_complexity": 1.0,
    "structural_order": 1.0,
    "rhythm_repetition": 1.0,
    "focal_strength": 1.0,
    "form_language": 1.0
  },
  "score_transformation": {
    "formula": "visual_proximity_score = round(100.0 * (1.0 - d_norm), 2)",
    "score_range": [0.00, 100.00],
    "identical_vector_score": 100.0,
    "opposite_extrema_score": 0.0,
    "midpoint_distance_0_5_score": 50.0,
    "ranking_sort_key": "unrounded_d_norm_ASC"
  },
