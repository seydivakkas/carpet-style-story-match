{
  "policy_version": "domain-randomization-policy-v1.0.0",
  "description": "Deterministic parameter bounds for synthetic carpet domain randomization layers.",
  "geometric": {
    "perspective": {
      "enabled": true,
      "probability": 0.5,
      "max_distortion": 0.15
    },
    "rotation": {
      "enabled": true,
      "probability": 0.6,
      "angle_range_deg": [-180.0, 180.0]
    },
    "scale": {
      "enabled": true,
      "probability": 0.8,
      "uniform_scale_range": [0.6, 1.4],
      "aspect_jitter_range": [0.85, 1.15]
    },
    "translation": {
      "enabled": true,
      "probability": 0.7,
      "max_offset_fraction": 0.25
    },
    "crop": {
      "enabled": true,
      "probability": 0.4,
      "min_visible_fraction_threshold": 0.20
    }
  },
  "photometric": {
    "brightness": {
      "enabled": true,
      "probability": 0.7,
      "factor_range": [0.75, 1.25]
    },
    "contrast": {
      "enabled": true,
      "probability": 0.7,
      "factor_range": [0.8, 1.25]
    },
    "gamma": {
      "enabled": true,
      "probability": 0.5,
      "gamma_range": [0.8, 1.25]
    },
    "saturation": {
      "enabled": true,
      "probability": 0.6,
      "factor_range": [0.7, 1.3]
    },
    "color_tint": {
      "enabled": true,
      "probability": 0.4,
      "max_tint_shift": 0.12
    }
  },
  "imaging": {
    "gaussian_blur": {
      "enabled": true,
      "probability": 0.4,
      "max_radius": 2.0
    },
    "gaussian_noise": {
      "enabled": true,
      "probability": 0.5,
      "std_dev_range": [0.01, 0.05]
    },
    "jpeg_compression": {
      "enabled": true,
      "probability": 0.6,
      "quality_range": [45, 95]
    }
  },
  "material_texture": {
    "fiber_noise": {
      "enabled": true,
      "probability": 0.8,
      "frequency": 8.0,
      "amplitude": 0.08
    },
    "wear_fading": {
      "enabled": true,
      "probability": 0.5,
      "low_freq_scale": 0.15
    },
    "edge_softness": {
      "enabled": true,
      "probability": 0.7,
      "feather_pixels": 1.5
    }
  },
  "occlusion": {
    "neutral_occluders": {
      "enabled": true,
      "probability": 0.4,
      "max_count": 3,
      "max_area_fraction": 0.15
    },
    "foreground_overlap": {
      "enabled": true,
      "probability": 0.5
    }
  }
}
